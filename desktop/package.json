{
  "name": "berps-staff",
  "version": "2.1.0",
  "description": "BERPS Desk — native staff desktop app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac dmg",
    "dist:win": "electron-builder --win nsis",
    "dist:linux": "electron-builder --linux AppImage"
  },
  "dependencies": {
    "electron-updater": "6.6.2"
  },
  "devDependencies": {
    "electron": "43.7.7",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.berps.staff",
    "productName": "BERPS Desk",
    "afterPack": "./build/afterPack.js",
    "files": [
      "main.js",
      "preload.js",
      "offline.html",
      "splash.html",
      "skin.css",
      "app/**/*",
      "extensions/**/*",
      "build/icon.png",
      "build/icon-dark.png",
      "node_modules/**",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.business",
      "target": "dmg",
      "identity": null
    },
    "dmg": {
      "title": "BERPS Desk"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Office"
    }
  }
}
